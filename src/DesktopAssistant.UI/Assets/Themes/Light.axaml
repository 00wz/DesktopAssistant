<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Surfaces ────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="WindowBg"                   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppBg"                      Color="#FAFAFA"/>
    <SolidColorBrush x:Key="PanelBg"                    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelSubtleBg"              Color="#F8F8F8"/>
    <SolidColorBrush x:Key="PanelHeaderBg"              Color="#F0F0F0"/>
    <SolidColorBrush x:Key="PanelSelectedBg"            Color="#E8F0FE"/>
    <SolidColorBrush x:Key="PanelBorderBrush"           Color="#E0E0E0"/>
    <SolidColorBrush x:Key="DividerBrush"               Color="#F0F0F0"/>
    <SolidColorBrush x:Key="EditorBg"                   Color="#EEF2FF"/>
    <SolidColorBrush x:Key="InfoBg"                     Color="#F0F4FF"/>
    <SolidColorBrush x:Key="InfoFg"                     Color="#1A3C6E"/>
    <SolidColorBrush x:Key="ChatSettingsBg"             Color="#F8F8FF"/>
    <SolidColorBrush x:Key="ChatSettingsBorderBrush"    Color="#DDEEFF"/>
    <SolidColorBrush x:Key="NavHoverOverlay"            Color="#20000000"/>

    <!-- ── Text ────────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="LabelFg"                    Color="#555555"/>
    <SolidColorBrush x:Key="SecondaryFg"                Color="#666666"/>
    <SolidColorBrush x:Key="MutedFg"                    Color="#888888"/>
    <SolidColorBrush x:Key="SubtleFg"                   Color="#999999"/>
    <SolidColorBrush x:Key="BodyFg"                     Color="#444444"/>
    <SolidColorBrush x:Key="ErrorFg"                    Color="#CC0000"/>
    <SolidColorBrush x:Key="WarningFg"                  Color="#CC8800"/>
    <SolidColorBrush x:Key="SuccessFg"                  Color="#2E7D32"/>

    <!-- ── Status / badges ─────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ErrorBg"                    Color="#FFE0E0"/>
    <SolidColorBrush x:Key="DangerBg"                   Color="#FFEBEE"/>
    <SolidColorBrush x:Key="DangerFg"                   Color="#C62828"/>
    <SolidColorBrush x:Key="BadgeDefaultBg"             Color="#007ACC"/>
    <SolidColorBrush x:Key="BadgeDefaultFg"             Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OnAccentFg"                 Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BadgePurpleBg"              Color="#F3E5F5"/>
    <SolidColorBrush x:Key="BadgePurpleFg"              Color="#6A1B9A"/>
    <SolidColorBrush x:Key="BadgeGreenBg"               Color="#E8F5E9"/>
    <SolidColorBrush x:Key="BadgeGreenFg"               Color="#2E7D32"/>

    <!-- ── Chat messages ───────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="UserMessageBg"              Color="#007ACC"/>
    <SolidColorBrush x:Key="ToolCallBg"                 Color="#F0F4FF"/>
    <SolidColorBrush x:Key="TerminalToolCallBg"         Color="#F5F5F5"/>
    <SolidColorBrush x:Key="TerminalToolCallBorderBrush" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="SummarizationBg"            Color="#FFF9E6"/>
    <SolidColorBrush x:Key="ToolApproveBg"              Color="#4CAF50"/>
    <SolidColorBrush x:Key="ToolDenyBg"                 Color="#F44336"/>
    <SolidColorBrush x:Key="AgentSuccessFg"             Color="#2E7D32"/>
    <SolidColorBrush x:Key="ToolMonoFg"                 Color="#333333"/>
    <SolidColorBrush x:Key="ToolResultFg"               Color="#226622"/>

    <!-- ── Sidebar ─────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="SidebarBg"                  Color="#F0F0F0"/>
    <SolidColorBrush x:Key="SidebarItemActiveBg"        Color="#E8F0F8"/>
    <SolidColorBrush x:Key="SidebarItemSelectedBg"      Color="#D8E8F5"/>
    <SolidColorBrush x:Key="SidebarItemSelectedAccent"  Color="#007ACC"/>
    <SolidColorBrush x:Key="SidebarItemHoverOverlay"    Color="#12000000"/>
    <SolidColorBrush x:Key="SidebarFg"                  Color="#1E1E1E"/>
    <SolidColorBrush x:Key="SidebarSecondaryFg"         Color="#777777"/>
    <SolidColorBrush x:Key="SidebarButtonHoverBg"       Color="#E2E2E2"/>
    <SolidColorBrush x:Key="SidebarButtonPressedBg"     Color="#D4D4D4"/>
    <SolidColorBrush x:Key="SidebarIconFg"              Color="#555555"/>
    <!-- Status icon foregrounds (semantic colours on light background) -->
    <SolidColorBrush x:Key="SidebarIconLoadingFg"       Color="#007ACC"/>
    <SolidColorBrush x:Key="SidebarIconPausedFg"        Color="#888888"/>
    <SolidColorBrush x:Key="SidebarIconQuestionFg"      Color="#D97706"/>
    <SolidColorBrush x:Key="SidebarIconErrorFg"         Color="#DC2626"/>

    <!-- ── Title bar ───────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TitleBarBg"                 Color="#F0F0F0"/>
    <SolidColorBrush x:Key="WinBtnFg"                   Color="#555555"/>
    <SolidColorBrush x:Key="WinBtnHoverBg"              Color="#E0E0E0"/>
    <SolidColorBrush x:Key="WinBtnPressedBg"            Color="#D0D0D0"/>
    <SolidColorBrush x:Key="WinCloseBtnHoverBg"         Color="#C42B1C"/>
    <SolidColorBrush x:Key="WinCloseBtnPressedBg"       Color="#A82318"/>

    <!-- ── Chat header ─────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ChatHeaderBg"               Color="#F5F5F5"/>
    <SolidColorBrush x:Key="ChatHeaderBorderBrush"      Color="#E0E0E0"/>
    <SolidColorBrush x:Key="ChatHeaderProfileFg"        Color="#666666"/>
    <SolidColorBrush x:Key="ChatHeaderTokenFg"          Color="#999999"/>

</ResourceDictionary>
